{
  "name": "omni-ui-components",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "publish:package": "(npm whoami >/dev/null 2>&1 || npm login --scope=@oc-tech --auth-type=web) && pnpm --filter @oc-tech/omni-ui-components publish --access public",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down -v",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
